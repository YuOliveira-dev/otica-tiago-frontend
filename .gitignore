# ==========================================
# TS EYEWEAR - Root .gitignore
# ==========================================

# 1. Dependências de Pacotes
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Arquivos de Ambiente e Credenciais Sensíveis (NUNCA COMMITTAR)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local
script-py-image-scam/.env
*.env
!.env.example
!**/.env.example
.env.example
# Pastas locais e documentação interna
agents/
**/agents/
docs/
**/docs/

# Arquivos Markdown (ignorar todos com exceção do README.md)
*.md
**/*.md
!README.md
!**/README.md
!readme.md
!**/readme.md

# 3. Next.js & Frontend Builds
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# 4. Logs e Depuração
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 5. Vercel & Deploy
.vercel
**/.vercel/

# 6. Uploads Locais e Scripts Temporários
backend/uploads/
**/uploads/
backend/scratch/
**/scratch/

# Backend (agora em repositório dedicado: otica-tiago-backend)
backend/

# 7. Script Local de Imagens (Não versionar no GitHub)
script-py-image-scam/
**/script-py-image-scam/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
**/venv/
**/env/
*.egg-info/

# 8. Sistema Operacional & Editores
.DS_Store
Thumbs.db
*.pem
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
